        }

        // Toggle Scratchpad Box
        function toggleScratchpad() {
            const box = document.getElementById('scratchpad-box');
            box.classList.toggle('hidden');
        }

        // Check Answer Logic
        function checkQuestionAnswer(qId) {
            const allQ = getAllQuestions();
            const q = allQ.find(item => item.id === qId);
            if (!q) return;

            let isCorrect = false;
            let userVal = null;
            let steps = '';

            if (q.type === 'mcq') {
                const selectedOpt = document.querySelector('input[name="mcq_opt"]:checked');
                if (!selectedOpt) {
                    alert('يرجى اختيار أحد الخيارات قبل التحقق!');
                    return;
                }
                userVal = parseInt(selectedOpt.value);
                isCorrect = userVal === q.correct;
            } else if (q.type === 'numeric') {
                const inputVal = document.getElementById('numeric-input').value;
                if (!inputVal) {
                    alert('يرجى إدخال الإجابة العددية أولاً!');
                    return;
                }
                userVal = parseFloat(inputVal);
                isCorrect = Math.abs(userVal - q.correctNumeric) < 0.01;
            } else {
                // Written steps
                steps = document.getElementById('written-input').value;
                if (!steps || steps.trim().length < 3) {
                    alert('يرجى كتابة خطوات الحل والتفسير الرياضي قبل التسليم!');
                    return;
                }
                isCorrect = true; // Recorded for manual teacher review
            }

            // Award Points & Badge Logic
            const scratch = document.getElementById('scratchpad-text')?.value || '';
            const firstTime = !state.solvedQuestions[qId]?.solved;

            state.solvedQuestions[qId] = {
                solved: true,
                userAnswer: userVal,
                writtenSteps: steps,
                scratchpad: scratch,
                correct: isCorrect
            };

            state.studentAttempts++;
            if (isCorrect) state.correctCount++;

            if (firstTime) {
                const addPts = isCorrect ? 50 : 20;
                state.points += addPts;
                
                // Badges Checks
                checkBadgesEarned();
                
                // Trigger Celebration Modal
                showCelebration("إنجاز رائع!", isCorrect ? "إجابتك صحيحة ودقيقة جداً!" : "تم تسليم خطوات تفكيرك بنجاح!", addPts);
            }

            saveUserData();
            renderView();
        }

        // Hint Handler
        function toggleHintModal(qId) {
            const q = getAllQuestions().find(i => i.id === qId);
            alert(`💡 تلميح رياضي مساعد:\n\n${q ? q.solution.substring(0, 80) + '...' : 'اقرئي السؤال بتمهل وحددي المعطيات والمطلوب.'}`);
        }

        // Save Question for Review Toggle
        function toggleSaveQuestion(qId, e) {
            if (e) e.stopPropagation();
            const idx = state.savedReviewList.indexOf(qId);
            if (idx > -1) {
                state.savedReviewList.splice(idx, 1);
            } else {
                state.savedReviewList.push(qId);
            }
            saveUserData();
            renderView();
        }

        // Question Nav Handlers
        function prevQuestion() {
            if (state.activeQuestionIndex > 0) {
                state.activeQuestionIndex--;
                renderView();
            }
        }

        function nextQuestion() {
            const allQ = getAllQuestions();
            if (state.activeQuestionIndex < allQ.length - 1) {
                state.activeQuestionIndex++;
                renderView();
            }
        }

        function openQuestionDirect(qId) {
            const allQ = getAllQuestions();
            const idx = allQ.findIndex(q => q.id === qId);
            if (idx !== -1) {
                state.activeQuestionIndex = idx;
                navigateTo('question');
            }
        }

        function startFirstUnsolved() {
            const allQ = getAllQuestions();
            const unsolvedIdx = allQ.findIndex(q => !state.solvedQuestions[q.id]?.solved);
            state.activeQuestionIndex = unsolvedIdx !== -1 ? unsolvedIdx : 0;
            navigateTo('question');
        }

        function playRandomQuestion() {
            const allQ = getAllQuestions();
            const randIdx = Math.floor(Math.random() * allQ.length);
            state.activeQuestionIndex = randIdx;
            navigateTo('question');
        }

        // Helper: Flat Array of All Questions
        function getAllQuestions() {
            let list = [];
            CHAPTERS_DATA.forEach(c => {
                list = list.concat(c.questions);
            });
            return list;
        }

        // 4. Lab "مختبر التفكير الرياضي" View
        function renderLabView() {
            const allQ = getAllQuestions();
            const higherQuestions = allQ.filter(q => q.isHigherThinking);

            let html = `
                <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 rounded-3xl p-6 sm:p-10 text-white shadow-xl mb-8">
                    <div class="flex items-center gap-3 text-amber-200 font-bold text-xs mb-2">
                        <i class="fa-solid fa-microscope text-base"></i>
                        <span>قسم إثرائي متقدم</span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-black mb-3">مختبر التفكير الرياضي</h2>
                    <p class="text-amber-100 text-xs sm:text-sm leading-relaxed max-w-2xl">
                        قسم خاص مخصص لجميع أسئلة مهارات التفكير العليا من الكتاب المدرسي (اكتشفي الخطأ، تحدي، مسألة مفتوحة، حس عددي، قارني واستنتجي، برري إجابتك).
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            `;

            higherQuestions.forEach((q, idx) => {
                const isSolved = state.solvedQuestions[q.id]?.solved;

                html += `
                    <div class="gamified-card bg-white rounded-3xl p-6 border border-slate-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs font-bold bg-amber-100 text-amber-800 px-3 py-1 rounded-full">
                                    <i class="fa-solid fa-brain"></i> ${q.skill}
                                </span>
                                <span class="text-xs font-bold text-slate-400">ص ${q.page}</span>
                            </div>

                            <p class="text-xs font-bold text-brand-primary mb-2">${q.lesson}</p>
                            <h4 class="text-sm sm:text-base font-bold text-slate-800 leading-relaxed mb-4">
                                ${q.text}
                            </h4>
                        </div>

                        <div class="flex items-center justify-between border-t border-slate-100 pt-4 mt-2">
                            <span class="text-xs font-bold ${isSolved ? 'text-emerald-600' : 'text-slate-400'}">
                                ${isSolved ? '<i class="fa-solid fa-check-circle"></i> مكتمل' : 'غير مكتمل'}
                            </span>
                            <button onclick="openQuestionDirect('${q.id}')" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md">
                                خوض التحدي
                            </button>
                        </div>
                    </div>
                `;
            });

            html += `</div>`;
            return html;
        }

        // 5. Badges View
        function renderBadgesView() {
            let html = `
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm mb-8 text-center">
                    <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-600 mx-auto mb-4 flex items-center justify-center text-3xl">
                        <i class="fa-solid fa-award"></i>
                    </div>
                    <h2 class="text-2xl font-black text-slate-800 mb-2">لوحة الأوسمة والإنجازات</h2>
                    <p class="text-xs text-slate-500 max-w-md mx-auto">احصلي على الأوسمة التعليمية المتميزة عند تحقيق المعايير المطلوبة في حل التحديات والمسائل.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            `;

            BADGES_DEFINITIONS.forEach(b => {
                const isEarned = state.earnedBadges.includes(b.id);

                html += `
                    <div class="gamified-card bg-white rounded-3xl p-6 border ${isEarned ? 'border-amber-300 bg-gradient-to-b from-amber-50/40 to-white' : 'border-slate-200 opacity-60'} text-center flex flex-col items-center justify-between">
                        <div>
                            <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr ${b.color} text-white mb-4 mx-auto flex items-center justify-center text-3xl shadow-lg ${isEarned ? 'badge-glow' : 'grayscale'}">
                                <i class="fa-solid ${b.icon}"></i>
                            </div>
                            <h4 class="text-base font-black text-slate-800 mb-1">${b.name}</h4>
                            <p class="text-xs text-slate-500 font-medium mb-4">${b.desc}</p>
                        </div>

                        <span class="text-xs font-extrabold px-4 py-1.5 rounded-full ${isEarned ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-500'}">
                            ${isEarned ? '<i class="fa-solid fa-check"></i> تم الحصول عليه' : 'مغلق حالياً'}
                        </span>
                    </div>
                `;
            });

            html += `</div>`;
            return html;
        }

        // Checks for Earned Badges
        function checkBadgesEarned() {
            const solvedCount = Object.keys(state.solvedQuestions).length;

            if (solvedCount >= 1 && !state.earnedBadges.includes('b1')) state.earnedBadges.push('b1');
            if (state.studentAttempts >= 5 && !state.earnedBadges.includes('b2')) state.earnedBadges.push('b2');
            if (state.correctCount >= 5 && !state.earnedBadges.includes('b3')) state.earnedBadges.push('b3');
            if (state.points >= 300 && !state.earnedBadges.includes('b7')) state.earnedBadges.push('b7');
        }

        // Celebration Overlay Manager
        function showCelebration(title, desc, pts) {
            document.getElementById('celeb-title').innerText = title;
            document.getElementById('celeb-desc').innerText = desc;
            document.getElementById('celeb-points').innerText = `+${pts} نقطة إنجاز`;
            document.getElementById('celebration-overlay').classList.remove('hidden');
        }

        function closeCelebration() {
            document.getElementById('celebration-overlay').classList.add('hidden');
        }

        // Image Zoom Modal Handlers
        function openZoomModal(type) {
            document.getElementById('zoom-content').innerHTML = renderDiagramBox(type);
            document.getElementById('zoom-modal').classList.remove('hidden');
        }

        function closeZoomModal() {
            document.getElementById('zoom-modal').classList.add('hidden');
        }

        // Teacher Dashboard Auth Handlers
        function openTeacherModal() {
            document.getElementById('teacher-auth-modal').classList.remove('hidden');
        }

        function closeTeacherModal() {
            document.getElementById('teacher-auth-modal').classList.add('hidden');
        }

        function verifyTeacherAccess(e) {
            e.preventDefault();
            const pass = document.getElementById('teacher-password-input').value;
            if (pass === '1234') {
                closeTeacherModal();
                renderTeacherDashboard();
            } else {
                alert('كلمة المرور غير صحيحة، يرجى المحاولة مجدداً.');
            }
        }

        // Render Teacher Dashboard Overlay Screen
        function renderTeacherDashboard() {
            const container = document.getElementById('app-container');
            const totalQ = getAllQuestions();
            const solvedCount = Object.keys(state.solvedQuestions).length;

            let html = `
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xl mb-8">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-6 mb-6">
                        <div>
                            <span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
                                <i class="fa-solid fa-user-tie"></i> لوحة المعلمة أسماء المطير
                            </span>
                            <h2 class="text-2xl font-black text-slate-800 mt-2">متابعة وتقييم أداء الطالبات</h2>
                        </div>
                        <button onclick="renderView()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-4 py-2 rounded-xl text-xs">
                            إغلاق اللوحة
                        </button>
                    </div>

                    <!-- Teacher Summary Cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                        <div class="bg-indigo-50 p-4 rounded-2xl border border-indigo-100">
                            <p class="text-xs font-bold text-indigo-600">إجمالي الأسئلة المحلولة:</p>
                            <p class="text-2xl font-black text-indigo-900 mt-1">${solvedCount} / ${totalQ.length}</p>
                        </div>
                        <div class="bg-emerald-50 p-4 rounded-2xl border border-emerald-100">
                            <p class="text-xs font-bold text-emerald-600">مجموع النقاط المكتسبة:</p>
                            <p class="text-2xl font-black text-emerald-900 mt-1">${state.points}</p>
                        </div>
                        <div class="bg-amber-50 p-4 rounded-2xl border border-amber-100">
                            <p class="text-xs font-bold text-amber-700">قائمة مراجعة التدقيق اليدوي:</p>
                            <p class="text-2xl font-black text-amber-900 mt-1">${totalQ.filter(q => q.type === 'written').length} أسئلة مقالية</p>
                        </div>
                    </div>

                    <!-- Written Answers Review Table -->
                    <h3 class="text-base font-black text-slate-800 mb-4">خطوات الحل والتبريرات المسجلة للطالبات:</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-xs text-right border-collapse">
                            <thead>
                                <tr class="bg-slate-100 text-slate-700 font-extrabold border-b border-slate-200">
                                    <th class="p-3">السؤال والدرس</th>
                                    <th class="p-3">الحالة</th>
                                    <th class="p-3">خطوات وتفسير الطالبة</th>
                                    <th class="p-3">الإجراء والتغذية</th>
                                </tr>
                            </thead>
                            <tbody>
            `;

            totalQ.filter(q => q.type === 'written').forEach(q => {
                const userSol = state.solvedQuestions[q.id];
                html += `
                    <tr class="border-b border-slate-100 hover:bg-slate-50">
                        <td class="p-3 font-bold text-slate-800">
                            ${q.lesson}<br>
                            <span class="text-[11px] text-slate-500 font-normal">${q.text.substring(0, 45)}...</span>
                        </td>
                        <td class="p-3">
                            ${userSol?.solved ? '<span class="text-emerald-600 font-bold">تم الإرسال</span>' : '<span class="text-slate-400">لم يحل</span>'}
                        </td>
                        <td class="p-3 font-medium text-slate-700">
                            ${userSol?.writtenSteps ? userSol.writtenSteps : '—'}
                        </td>
                        <td class="p-3">
                            <button onclick="alert('تم اعتماد درجة الخطوات وإضافة تغذية راجعة من المعلمة أسماء المطير.')" class="bg-brand-primary text-white font-bold px-3 py-1 rounded-lg text-[11px]">
                                اعتمد التقييم
                            </button>
                        </td>
                    </tr>
                `;
            });

            html += `
                            </tbody>
                        </table>
                    </div>
                </div>
            `;

            container.innerHTML = html;
        }
    </script>
</body>
</html>

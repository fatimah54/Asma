        // Feedback Renderer Helper
        function renderFeedbackBox(q, sol) {
            if (q.type === 'mcq' || q.type === 'numeric') {
                const isCorrect = sol.correct;
                return `
                    <div class="p-5 rounded-2xl border ${isCorrect ? 'bg-emerald-50 border-emerald-200 text-emerald-900' : 'bg-rose-50 border-rose-200 text-rose-900'}">

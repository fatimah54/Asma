                                <i class="${isSaved ? 'fa-solid' : 'fa-regular'} fa-bookmark"></i>
                                <span>${isSaved ? 'محفوظ للمراجعة' : 'حفظ للمراجعة'}</span>
                            </button>
                        </div>

                        <!-- Question Text -->
                        <h3 class="text-lg sm:text-xl font-black text-slate-900 leading-relaxed mb-6">
                            ${currentQ.text}
                        </h3>

                        <!-- Diagram Render -->
                        ${currentQ.diagramType ? renderDiagramBox(currentQ.diagramType) : ''}

                        <!-- Answer Input Field -->
                        <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200 mb-6">
                            <h4 class="text-xs font-bold text-slate-700 mb-3 flex items-center gap-2">
                                <i class="fa-solid fa-pen-to-square text-brand-primary"></i>
                                مساحة الإجابة والحل:
                            </h4>
            `;

            if (currentQ.type === 'mcq') {
                html += `<div class="space-y-3">`;

                    <div class="p-5 rounded-2xl border ${isCorrect ? 'bg-emerald-50 border-emerald-200 text-emerald-950' : 'bg-amber-50 border-amber-200 text-amber-950'}">
                        <div class="flex items-center gap-3 mb-2 font-black text-base">
                            <i class="fa-solid ${isCorrect ? 'fa-circle-check text-emerald-600 text-xl' : 'fa-lightbulb text-amber-600 text-xl'}"></i>
                            <span>${isCorrect ? 'أحسنتِ! تفكيركِ يقودكِ إلى التميز!' : 'محاولة جيدة! لنفكر في الحل بطريقة أخرى'}</span>
                        </div>
                        <p class="text-xs font-bold leading-relaxed mb-1">طريقة الحل والتفسير المعتمد:</p>
                        <p class="text-xs leading-relaxed font-medium">${q.solution}</p>
                    </div>
                `;
            } else {
                return `
                    <div class="p-5 rounded-2xl bg-indigo-50 border border-indigo-200 text-indigo-950">
                        <div class="flex items-center gap-2 mb-2 font-black text-sm">
                            <i class="fa-solid fa-circle-check text-indigo-600"></i>
                            <span>رائعة! لقد استخدمتِ تفكيرًا رياضيًا مميزًا وتم حفظ خطواتكِ!</span>
                        </div>
                        <p class="text-xs font-bold mb-1">نموذج الحل والتفسير الرياضي:</p>
                        <p class="text-xs font-medium leading-relaxed">${q.solution}</p>
                    </div>
                `;
            }
        }

        // Check Answer Logic
        function checkQuestionAnswer(qId) {
            const allQ = getAllQuestions();
            const q = allQ.find(i => i.id === qId);
            if (!q) return;

            let isCorrect = false;
            let userVal = null;
            let steps = '';

            if (q.type === 'mcq') {
                const selectedOpt = document.querySelector('input[name="mcq_opt"]:checked');
                if (!selectedOpt) { alert('يرجى اختيار إجابة أولاً!'); return; }
                userVal = parseInt(selectedOpt.value);
                isCorrect = userVal === q.correct;
            } else if (q.type === 'numeric') {
                const inputVal = document.getElementById('numeric-input').value;
                if (!inputVal) { alert('يرجى إدخال القيمة العددية!'); return; }
                userVal = parseFloat(inputVal);
                isCorrect = Math.abs(userVal - q.correctNumeric) < 0.01;
            } else {
                steps = document.getElementById('written-input').value;
                if (!steps || steps.trim().length < 3) { alert('يرجى كتابة خطوات الحل والتبرير!'); return; }
                isCorrect = true;
            }

            const firstTime = !state.solvedQuestions[qId]?.solved;
            state.solvedQuestions[qId] = { solved: true, userAnswer: userVal, writtenSteps: steps, correct: isCorrect };
            state.studentAttempts++;
            if (isCorrect) state.correctCount++;

            if (firstTime) {
                const addPts = isCorrect ? 50 : 25;
                state.points += addPts;
                checkBadgesEarned();
                showCelebration("إنجاز رائع!", isCorrect ? "أحسنتِ، تفكيركِ يقودكِ إلى التميز!" : "محاولة ممتازة! تم حفظ خطوات حلّك والتفسير.", addPts);
            }

            saveUserData();
            renderView();
        }

        function toggleHintModal(qId) {
            const q = getAllQuestions().find(i => i.id === qId);
            alert(`💡 تلميح رياضي مساعد:\n\n${q ? q.solution.substring(0, 90) + '...' : 'اقرئي السؤال بتمهل وحددي المعطيات.'}`);
        }

        function toggleSaveQuestion(qId, e) {
            if (e) e.stopPropagation();
            const idx = state.savedReviewList.indexOf(qId);
            if (idx > -1) state.savedReviewList.splice(idx, 1);
            else state.savedReviewList.push(qId);
            saveUserData();
            renderView();
        }

        function prevQuestion() {
            if (state.activeQuestionIndex > 0) { state.activeQuestionIndex--; renderView(); }
        }

        function nextQuestion() {
            const allQ = getAllQuestions();
            if (state.activeQuestionIndex < allQ.length - 1) { state.activeQuestionIndex++; renderView(); }
        }

        function openQuestionDirect(qId) {
            const allQ = getAllQuestions();
            const idx = allQ.findIndex(q => q.id === qId);
            if (idx !== -1) { state.activeQuestionIndex = idx; navigateTo('question'); }
        }

        function startFirstUnsolved() {
            const allQ = getAllQuestions();
            const unsolvedIdx = allQ.findIndex(q => !state.solvedQuestions[q.id]?.solved);
            state.activeQuestionIndex = unsolvedIdx !== -1 ? unsolvedIdx : 0;
            navigateTo('question');
        }

        function playRandomQuestion() {
            const allQ = getAllQuestions();
            state.activeQuestionIndex = Math.floor(Math.random() * allQ.length);
            navigateTo('question');
        }

        function getAllQuestions() {
            let list = [];
            CHAPTERS_DATA.forEach(c => { list = list.concat(c.questions); });
            return list;
        }


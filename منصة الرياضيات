                                </span>
                                ${currentQ.isHigherThinking ? `<span class="mr-2 text-xs font-bold bg-amber-100 text-amber-900 border border-amber-200 px-2.5 py-1 rounded-lg"><i class="fa-solid fa-brain"></i> ${currentQ.skill}</span>` : ''}

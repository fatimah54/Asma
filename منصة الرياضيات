                    const isSelected = userSol.userAnswer === oIdx;
                    html += `
                        <label class="flex items-center p-4 rounded-xl border-2 ${isSelected ? 'border-brand-primary bg-indigo-50/80' : 'border-slate-200 bg-white'} hover:border-indigo-300 cursor-pointer transition-all">

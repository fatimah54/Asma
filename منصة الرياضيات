        // Mascot Smart Advice Trigger
        function triggerMascotTip() {
            const txt = MASCOT_TIPS[Math.floor(Math.random() * MASCOT_TIPS.length)];
            const bubble = document.getElementById('mascot-bubble');
            document.getElementById('mascot-text').innerText = txt;
            bubble.classList.remove('opacity-0', 'scale-90');
            setTimeout(() => { bubble.classList.add('opacity-0', 'scale-90'); }, 4000);
        }

        // Check Badges
        function checkBadgesEarned() {
            const solvedCount = Object.keys(state.solvedQuestions).length;
            if (solvedCount >= 1 && !state.earnedBadges.includes('b1')) state.earnedBadges.push('b1');
            if (state.studentAttempts >= 5 && !state.earnedBadges.includes('b2')) state.earnedBadges.push('b2');
            if (state.correctCount >= 5 && !state.earnedBadges.includes('b3')) state.earnedBadges.push('b3');
            if (state.points >= 300 && !state.earnedBadges.includes('b7')) state.earnedBadges.push('b7');
        }

        function showCelebration(title, desc, pts) {
            playChimeSound();
            document.getElementById('celeb-title').innerText = title;
            document.getElementById('celeb-desc').innerText = desc;
            document.getElementById('celeb-points').innerText = `+${pts} نقطة إنجاز`;
            document.getElementById('celebration-overlay').classList.remove('hidden');
        }

        function closeCelebration() {
            document.getElementById('celebration-overlay').classList.add('hidden');

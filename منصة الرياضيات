                                    <button onclick="toggleSaveQuestion('${q.id}', event)" class="text-slate-500 hover:text-amber-400 text-sm p-1">
                                        <i class="${isSaved ? 'fa-solid text-amber-400' : 'fa-regular'} fa-bookmark"></i>

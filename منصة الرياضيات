                    <button onclick="filterLesson('${les}')" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-colors ${active ? 'bg-brand-primary text-white' : 'bg-slate-800 text-slate-400 hover:bg-slate-700'}">
